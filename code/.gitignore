.pio/

# Generated by `pio run -e esp32s3 -t compiledb`. It is a build artifact (every
# path inside it is absolute and machine-specific), and it is deliberately KEPT
# on disk rather than deleted: it is the check that a lib/ source is really being
# compiled -- see the lib/ CMakeLists.txt note. Ignored, not removed.
compile_commands.json

# clangd's index cache, dropped beside compile_commands.json. Machine-local and
# absolute-path-laden, like the compile database itself.
.cache/

# Local dev secrets — never commit. Not part of this project.
.env

# The repo-root .gitignore is a KiCad template that ignores *.csv. That rule
# silently swallows this project's partition table, which is a source file.
!partitions.csv

.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
sdkconfig
sdkconfig.old
# PlatformIO names the generated IDF config after the env ($PIOENV).
sdkconfig.esp32s3
*.swp
build/
android/.gradle/
android/local.properties
android/**/build/
.kilo/worktrees

# Google Drive sync artifacts. This workspace lives in Drive, which drops
# zero-byte `.~<random>.insyncdl` placeholders into directories it is syncing.
# They are transient, empty, and must never be committed -- and because they
# appear inside SOURCE directories (lib/Output/), a `git add <dir>` would catch
# one. See the global-constraints rule on explicit file paths.
.~*.insyncdl

# Fetched IDF components from src/idf_component.yml. Vendored third-party source,
# ~23 MB / 2570 files, and reproducible from the lock file below -- so it is
# ignored rather than committed, exactly like .pio/.
#
# dependencies.lock IS committed (do not add it here): it pins the exact resolved
# versions (esp_tinyusb 2.3.0, tinyusb 0.21.0~2) so a fresh clone fetches the same
# components this build was verified against. Ignoring both would make the build
# depend on whatever the registry serves that day.
managed_components/


# --- Android / Gradle -------------------------------------------------------
# The Gradle WRAPPER is committed deliberately (gradlew, gradlew.bat,
# gradle/wrapper/*) -- it is what pins the Gradle version for every checkout, and
# a build script that only works with "whatever gradle you have" is not
# reproducible.
.local/
.kotlin/
# The fixture EmitFixtureTest writes. It is a build output that exists to be fed
# to tools/crosscheck_config.sh, not a source file.
android/app/build/
