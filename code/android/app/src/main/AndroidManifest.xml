<?xml version="1.0" encoding="utf-8"?>
<!--
  The SWC adapter app.

  `android.hardware.usb.host` is REQUIRED, not optional: the app talks to the
  device only over USB, so on a host-mode-less device it can do nothing at all.
  Declaring it required keeps the app off those devices entirely rather than
  installing it and failing at the first connect.

  There is an `INTERNET` permission here for spec 9.5's release check (open item
  N-12, resolved 2026-09-24). An earlier version of this comment claimed the
  absence was deliberate, that "the device fetches its own manifest", which
  contradicts spec 9.5: the ESP32 may have no WiFi in the car, so the spec puts the
  release check in the APP, over the phone's own connection, with the resulting
  file pushed to the device over USB. The permission is declared below; the fetch
  itself is `HttpManifestFetcher`, over HTTPS, and the comparison is
  `ReleaseManifest` (a mirror of the firmware's `ReleaseCheck`).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!--
      Spec 9.5's release check runs in the app because the ESP32 may have no WiFi
      in the car. `AppViewModel.checkForUpdates` fetches `version_manifest.json`
      through `HttpManifestFetcher` and compares it against the running firmware
      with `ReleaseManifest`, so the app needs the network. Without this every
      fetch fails with a SecurityException that reads as "the release server is
      unreachable".

      It is `INTERNET` alone, deliberately NOT `ACCESS_NETWORK_STATE`: the fetcher
      makes one short GET on an explicit user action and needs no connectivity
      query to decide anything.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Package visibility (Android 11+, API 30+), and the app targets 34.

      `ActionRunner` decides whether an `APP_LAUNCH` / `APP_INTENT` binding can
      fire by ASKING about the package (getLaunchIntentForPackage,
      queryIntentActivities). Since Android 11 those queries are FILTERED: an app
      the user bound a button to is invisible to the query unless it is visible
      automatically or declared here, so the query returns null and the app
      reports "not installed" for an app that is installed and launchable.

      That is the sharp edge: starting an activity does NOT need visibility.
      Per developer.android.com/training/package-visibility/automatic, "you can
      start another app's activity using either an implicit or explicit intent
      regardless of whether that app is visible to your app". So the query was
      the ONLY thing failing; the launch it gated would have worked. Without this
      element `APP_LAUNCH` and `APP_INTENT` are dead for every targeted app that
      is not automatically visible, which is most of them.

      WHAT IS DECLARED: an intent signature, which makes every installed app
      matching it visible. A <package> entry cannot cover these, because the
      target is the user's choice at runtime (any package for `APP_LAUNCH`, any
      action for `APP_INTENT`), so there is no fixed name to list. The broadest
      available option is QUERY_ALL_PACKAGES, which is a Google Play
      policy-gated permission not granted to an ordinary utility app, so the
      intent-signature route is both the narrower and the shippable one.

      The MAIN/LAUNCHER pair is the load-bearing one: getLaunchIntentForPackage
      resolves exactly that intent, so declaring it is what makes an arbitrary
      installed app discoverable for `APP_LAUNCH`. It also covers `APP_INTENT`
      for launcher-style actions; the app additionally falls back to an explicit
      package intent for a launch, which needs no visibility at all.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="SWC"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!--
          The launcher activity, declared here rather than left to convention.

          Its ABSENCE was a real defect: the APK installed fine and `am start`
          failed with "Activity class com.oetsolutions.swc.MainActivity does not exist",
          so the app could never be opened at all. No JVM test could see it,
          because Robolectric calls the composables directly and never goes
          through the manifest; neither could `assembleDebug`, which does not
          check launchability. Running it on an emulator is what found it.

          No `android:exported` on an <activity> is an install-time error from
          Android 12 on; `true` is correct here because a launcher activity must
          be startable from outside the app.

          The name is `.ui.MainActivity`, NOT `.MainActivity`. A leading dot
          expands against the application ID (com.oetsolutions.swc), but the class
          lives in the `ui` sub-package with the screens it hosts. Declaring the
          short form names a class that does not exist: it installs, then dies
          at launch with ClassNotFoundException. `LauncherActivityTest` now
          resolves this string to a real class so the two cannot drift again.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="SWC"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
