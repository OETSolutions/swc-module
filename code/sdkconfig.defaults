# --- Flash size ------------------------------------------------------------
# CORRECTION to the brief (see bring-up-log.md): platformio.ini's
# board_build.flash_size = 4MB is NOT honoured on pioarduino's ESP-IDF path --
# the board->sdkconfig injection is Arduino-gated, so IDF fell back to its own
# 2MB default and the build emitted "Flash memory size mismatch detected.
# Expected 4MB, found 2MB!". ESPTOOLPY_FLASHSIZE is a Kconfig *choice*, so it
# must be selected in choice form; the string form
# CONFIG_ESPTOOLPY_FLASHSIZE="4MB" is silently ignored.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Console and USB -------------------------------------------------------
# Console on **UART0** (TP7 `/TXD0`, TP8 `/RXD0` on this board), never on the
# TinyUSB CDC app link, and NEVER on USB-Serial-JTAG (N-16, fixed 2026-09-25).
#
# **Why not USB-Serial-JTAG.** The ESP32-S3 has ONE internal USB PHY shared by
# USB-Serial-JTAG and USB-OTG; installing TinyUSB at boot (`UsbLinkStart` ->
# `tinyusb_driver_install`) moves the PHY to USB-OTG, so a console left on
# USB-Serial-JTAG goes DARK the moment the app link comes up. Every `ESP_LOG*`
# line after that point was unreadable -- including `UsbLinkStart`'s OWN
# "tinyusb driver install failed", the message that reports the link failing.
# An earlier revision of this file claimed "Both can be up at once on the S3
# because USB-Serial-JTAG is a ROM peripheral independent of the OTG
# controller"; that is FALSE for this part (Espressif: "both controllers share
# a single internal PHY, allowing only one to operate at a time"; spec 4.1) and
# is precisely the claim N-16 exists to refute.
#
# **Why this needs no respin** (what N-16 asked to decide "before the board is
# finalised"): UART0 is independent of the USB PHY, so its console survives
# TinyUSB taking the PHY -- and the fabricated board ALREADY breaks UART0 out to
# test pads TP7/TP8 (bare THT pads on nets /TXD0 and /RXD0, nothing else on
# them). The spec's line "needs header pins or test pads on a respin" is wrong
# for this board.
#
# USB-Serial-JTAG is kept as the SECONDARY console so its output is duplicated
# there (non-blocking) -- `pio test -e esp32s3` and a plain serial monitor on the
# USB port still see the boot log until TinyUSB installs, while the durable
# console lives on the UART pads. Neither channel is the TinyUSB CDC port, so a
# debug byte can still never be parsed as a protocol frame (the HARD requirement
# of spec 4.1, asserted on-device by TestUsbCdc.cpp).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# TinyUSB is the MANAGED component `espressif/esp_tinyusb`, fetched by
# src/idf_component.yml -- IDF 5.5.5 ships no components/tinyusb of its own.
#
# These keys were absent until Task 14c, and the note that used to sit here said
# they would be "silently inert". That was true when nothing depended on them and
# is FALSE now: with CDC disabled the component's own header fails to COMPILE
# ("TinyUSB CDC driver must be enabled in menuconfig", tinyusb_cdc_acm.h:18) and
# its CMakeLists does not even add tinyusb_cdc_acm.c to the build. A managed
# component's Kconfig IS read by this build; only IDF's OWN config was ever the
# thing that could be missing.
CONFIG_TINYUSB_CDC_ENABLED=y

# 1024-byte frames (kNdjsonMaxFrame) over a Full-Speed link. The RX FIFO must be
# at least the largest single callback delivery, and the EP buffer governs how
# much moves per USB transaction. Both at the frame cap means a maximum frame can
# arrive, and be handed to the assembler, in one pass.
#
# TX is deliberately NOT enlarged: a 512-byte TX FIFO is the back-pressure that
# keeps a short write honest, and UsbCdc's retry accounting is written against it
# (a 1024-byte frame takes two flush rounds). Raising TX to hide that would leave
# the retry path untested on device -- the exact code path whose bug is a
# silently missed key.
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_EP_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512

# --- Bluetooth: NimBLE, not Bluedroid --------------------------------------
# Bluedroid does not fit 4MB/no-PSRAM alongside WiFi + OTA (spec 9.2).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# --- mbedTLS ---------------------------------------------------------------
# Disable hardware AES. The field-reported TLS crashes trace to the mbedTLS
# GCM/HARDWARE_AES path (espressif/esp-idf#14298, IDFGH-13390); with it off we
# take the software AES path, which is what the OTA flow is tested against.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y

# The WiFi OTA trust anchor is now a PINNED CA (`lib/Update/ReleaseCa.h`, N-62
# fixed), set via `cfg.cert_pem`, so the stock Mozilla cert BUNDLE is no longer
# used and is DISABLED -- that is a few hundred KB of flash back on a 4 MB/no-PSRAM
# part. (`esp_crt_bundle` is no longer included anywhere; `grep esp_crt_bundle`
# returns only comments.) N-62 records the fix; `tools/check_release_ca.py` guards
# the pin's single-cert shape and expiry.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# --- ADC -------------------------------------------------------------------
# NOTE: there is deliberately NO ADC calibration key here, because on this
# target there is no such Kconfig symbol to set.
#
# The brief specified CONFIG_ESP_ADC_CAL_USE_EFUSE_CALIBRATION and
# CONFIG_ESP_ADC_CAL_DEFAULT_ATTENUATION_12. Neither is defined anywhere in IDF
# 5.5.5. The real ADC calibration keys (ADC_CALI_EFUSE_TP_ENABLE,
# ADC_CALI_EFUSE_VREF_ENABLE, ADC_CALI_LUT_ENABLE, esp_adc/Kconfig:22,30,38) are
# `depends on IDF_TARGET_ESP32`, so they are inert on the ESP32-S3 too.
#
# On the S3, per-chip calibration is a RUNTIME API, not a build knob:
# `adc_cali_create_scheme_curve_fitting()` (SOC_ADC_CALIBRATION_V1_SUPPORTED).
# Task 4 (`CalibrationCurve`) owns that call and spec 2.3's 25 mV error budget.
# Setting a key here would have looked like calibration while doing nothing.

# --- Crash handling --------------------------------------------------------
# Coredump partition exists (partitions.csv). Reset in release; gdbstub in dev.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# --- App rollback (FR-37) --------------------------------------------------
# **This key was MISSING, and without it FR-37's rollback did not exist.**
# `partitions.csv` has the A/B slots (ota_0/ota_1 + otadata), and `main.cpp` calls
# `esp_ota_mark_app_valid_cancel_rollback()` on the confirmed-healthy path -- but
# that call is an explicit no-op unless the BOOTLOADER is built with this option
# (IDF 5.5.5, `components/bootloader/Kconfig.app_rollback`: the flag is what makes
# the bootloader start a freshly-updated app in `ESP_OTA_IMG_PENDING_VERIFY` and
# revert after a boot-loop). Default OFF, so an image that boots into a crash loop
# would have spun forever with no fallback -- while `UpdateScreen` tells the user
# "a failed or interrupted update does not leave you with a dead adapter" and
# `hello.caps` advertises `ota`. Spec 9.4/FR-37 make A/B rollback a hard
# requirement, and this is the single flag that decides whether it happens.
#
# `defaults` is the ONLY place this can live: `sdkconfig.esp32s3` is a gitignored
# build artifact (code/.gitignore:27), so a value set only there does not survive a
# clean build.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
